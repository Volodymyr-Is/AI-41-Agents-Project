+/**
+ * Calculate calories burned using MET formula.
+ * @param met Metabolic equivalent of task (MET)
+ * @param weightKg Weight in kilograms
+ * @param durationMinutes Duration in minutes
+ * @returns Calories burned, rounded to one decimal place
+ * @throws Error if any parameter is not a positive number
+ */
+export function calculateMetCalories(met: number, weightKg: number, durationMinutes: number): number {
+  if (met <= 0 || weightKg <= 0 || durationMinutes <= 0) {
+    throw new Error('All parameters must be positive numbers');
+  }
+  const calories = met * weightKg * (durationMinutes / 60);
+  return Math.round(calories * 10) / 10;
+}
