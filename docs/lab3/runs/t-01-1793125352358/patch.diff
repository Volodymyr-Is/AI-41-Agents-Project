+import { describe, it, expect } from 'vitest';
+import { calculateMetCalories } from '../src/utils/met-calc';
+
+describe('calculateMetCalories', () => {
+  it('calculates calories correctly for typical values', () => {
+    expect(calculateMetCalories(8, 70, 30)).toBe(280);
+    expect(calculateMetCalories(3.5, 60, 45)).toBe(157.5);
+  });
+
+  it('rounds result to one decimal place', () => {
+    expect(calculateMetCalories(1, 1, 10)).toBe(0.2);
+    expect(calculateMetCalories(1, 1, 1)).toBe(0);
+  });
+
+  it('throws error for non-positive MET', () => {
+    expect(() => calculateMetCalories(0, 70, 30)).toThrow();
+    expect(() => calculateMetCalories(-1, 70, 30)).toThrow();
+  });
+
+  it('throws error for non-positive weight', () => {
+    expect(() => calculateMetCalories(8, 0, 30)).toThrow();
+    expect(() => calculateMetCalories(8, -5, 30)).toThrow();
+  });
+
+  it('throws error for non-positive duration', () => {
+    expect(() => calculateMetCalories(8, 70, 0)).toThrow();
+    expect(() => calculateMetCalories(8, 70, -10)).toThrow();
+  });
+});
