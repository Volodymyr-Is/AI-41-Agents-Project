+import { describe, it, expect } from 'vitest';
+import { calculateMetCalories } from '../src/utils/met-calc';
+
+describe('calculateMetCalories', () => {
+  it('calculates calories using MET formula', () => {
+    const result = calculateMetCalories(3.5, 70, 60);
+    expect(result).toBe(245);
+  });
+
+  it('rounds to 1 decimal place', () => {
+    const result = calculateMetCalories(1.5, 65, 45);
+    expect(result).toBe(73.1);
+  });
+
+  it('throws on negative MET', () => {
+    expect(() => calculateMetCalories(-3, 70, 60)).toThrow();
+  });
+
+  it('throws on negative weight', () => {
+    expect(() => calculateMetCalories(3, -70, 60)).toThrow();
+  });
+
+  it('throws on negative duration', () => {
+    expect(() => calculateMetCalories(3, 70, -60)).toThrow();
+  });
+});
